# ===================== Database =====================
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ===================== Auth (JWT) =====================
JWT_ACCESS_SECRET="your-access-secret-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# ===================== Telegram bot (to'lov eslatmalari) =====================
# @BotFather dan olingan token. Faqat shu bot bilan ishlaymiz (guruh shart emas).
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"

# Webhook sozlashda ixtiyoriy xavfsizlik kaliti (setWebhook secret_token)
TELEGRAM_WEBHOOK_SECRET=""

# Vercel cron: Bearer auth (/api/cron/*, /api/cron/ttlock-callback-retry)
CRON_SECRET="your-cron-secret-min-16-chars"

# ===================== App =====================
# Same-origin relative path (recommended). Absolute origin without /api is auto-normalized.
NEXT_PUBLIC_API_URL="/api"
NEXT_PUBLIC_APP_URL="https://ijaraai.uz"

# Multi-tenant SaaS / demo workspaces (server-only — never NEXT_PUBLIC_)
# Demo trial length in days (default 14)
DEMO_TRIAL_DAYS=14
# Optional: mark this email as internal (subscription bypass) in addition to SUPER_ADMIN
INTERNAL_ACCOUNT_EMAIL=""
# Production: set true to allow public workspace signup (creates DEMO workspace)
ENABLE_WORKSPACE_SIGNUP=false
ALLOW_PUBLIC_REGISTER=false
# Phone OTP: set when SMS provider is wired (otherwise /api/auth/phone-status reports unavailable)
SMS_PROVIDER_ENABLED=false

# ===================== Email OTP (Resend) =====================
# Server-only — never expose RESEND_API_KEY to the client bundle.
RESEND_API_KEY=""
EMAIL_FROM="Ijara AI <noreply@ijaraai.uz>"
EMAIL_OTP_EXPIRY_MINUTES=10

# Bir martalik DB init (ixtiyoriy)
SETUP_SECRET=""

# OpenAI (AI agent — keyinroq)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Vercel Blob (rasm yuklash — Instagram uchun public URL)
BLOB_READ_WRITE_TOKEN=""

# ===================== Instagram Graph API =====================
INSTAGRAM_ENABLED=false
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_REDIRECT_URI="https://www.arendaai.uz/api/integrations/instagram/callback"
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_ACCOUNT_ID=""

# ===================== TTLock / Sciener (server-only) =====================
# Hech qachon NEXT_PUBLIC_ qilmang — frontend bundle'ga chiqmasin.
# Qiymatlar Sciener Developer Application tasdiqlangach to'ldiriladi.
TTLOCK_CLIENT_ID=
TTLOCK_CLIENT_SECRET=
TTLOCK_ACCOUNT_USERNAME=
# TTLock APP hisob paroli (32 belgi, kichik harf, MD5) — loglarga yozilmasin
TTLOCK_ACCOUNT_PASSWORD_MD5=
# Default: https://euapi.ttlock.com (bo'sh qoldirilsa kod default ishlatadi)
TTLOCK_API_BASE_URL=
# AES-256-GCM uchun 32 bayt kalit (masalan: openssl rand -hex 32)
TTLOCK_TOKEN_ENCRYPTION_KEY=
# Callback (9-bosqich) — faqat server-side
# Masalan: https://www.arendaai.uz/api/integrations/ttlock/callback
TTLOCK_CALLBACK_URL=
# Rasmiy platforma signing secret bersa — hozircha TTLock EU bermaydi
TTLOCK_CALLBACK_SIGNING_SECRET=

# ===================== AI Employees / Hermes Agent Gateway =====================
# Production fail-closed unless explicitly true. Never give these secrets to Hermes process
# except HERMES_* client id/secret (same values as AGENT_GATEWAY_*).
# Hermes must NOT receive DATABASE_URL, TELEGRAM_BOT_TOKEN, or TTLOCK_*.
AI_EMPLOYEES_ENABLED=false
AGENT_GATEWAY_ISSUER=arenda-ai-agent-gateway
AGENT_GATEWAY_AUDIENCE=hermes-arenda-ai
AGENT_GATEWAY_CLIENT_ID=hermes-arenda-ai
AGENT_GATEWAY_CLIENT_SECRET=
AGENT_GATEWAY_SIGNING_SECRET=
AGENT_GATEWAY_TOKEN_TTL_SEC=600
# Optional static Bearer for LWN Telegram auto-reply → /api/internal/agent/v1/rooms/available
LWN_TELEGRAM_AGENT_TOKEN=
HERMES_ARENDA_API_BASE_URL=https://www.arendaai.uz
HERMES_ARENDA_CLIENT_ID=hermes-arenda-ai
HERMES_ARENDA_CLIENT_SECRET=
HERMES_DAILY_REPORT_TIMEZONE=Asia/Tashkent
HERMES_DAILY_REPORT_HOUR=8
