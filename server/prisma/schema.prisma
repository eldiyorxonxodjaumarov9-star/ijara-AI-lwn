// ArendaHub — Enterprise Property Management SaaS
// Prisma schema (PostgreSQL)

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== ENUMS =====================

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EMPLOYEE
}

enum PropertyStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  RESERVED
}

enum ContractStatus {
  PENDING
  ACTIVE
  EXPIRED
  TERMINATED
}

enum PaymentMethod {
  CASH
  CARD
  BANK
}

enum ExpenseCategory {
  UTILITIES
  SALARY
  TAX
  REPAIR
  MARKETING
  ADVANCE
  OTHER
}

enum MonthlyExpenseType {
  WATER
  ELECTRICITY
  OFFICE
  CUSTOM
}

enum RecurrenceInterval {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  YEARLY
}

enum ExpenseSource {
  MANUAL
  RECURRING_EXPENSE
}

enum MaintenanceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  CONTRACT_EXPIRED
  LATE_PAYMENT
}

enum ClientStatus {
  NEW
  MATCHED
  ARCHIVED
}

enum ContactInterest {
  INTERESTED
  CALLED
  THINKING
  VISITED
  FOLLOW_UP
  NOT_INTERESTED
}

enum RoomAccessGrantStatus {
  PLANNED
  CANCELLED
}

enum RoomAccessPermissionType {
  PIN
  APP
  CARD
  PERMANENT
  TEMPORARY
}

enum TtlockConnectionStatus {
  DISCONNECTED
  CONNECTED
  TOKEN_EXPIRED
  ERROR
  SYNCING
}

enum TtlockDeviceOnlineStatus {
  UNKNOWN
  ONLINE
  OFFLINE
}

enum TtlockAccessCredentialType {
  PASSCODE
  EKEY
}

enum TtlockAccessSyncStatus {
  PLANNED
  PENDING_SYNC
  SENT
  ACTIVE
  EXPIRED
  REVOKE_PENDING
  REVOKED
  FAILED
}

enum TtlockRemoteCommandType {
  UNLOCK
  LOCK
}

enum TtlockRemoteCommandStatus {
  PENDING
  SUCCEEDED
  FAILED
  UNKNOWN
}

// ===================== MODELS =====================

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String
  fullName            String
  phone               String?
  role                Role      @default(EMPLOYEE)
  isActive            Boolean   @default(true)
  avatarUrl           String?
  language            String    @default("uz")
  refreshTokenHash    String?
  resetToken          String?
  resetTokenExp       DateTime?
  lastLoginAt         DateTime?
  telegramAdminChatId String?   @unique
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  notifications        Notification[]
  auditLogs            AuditLog[]
  telegramAdminDevices TelegramAdminDevice[]
  ttlockConnections    TtlockConnection[]
  ttlockRemoteCommands TtlockRemoteCommand[]

  @@index([role])
  @@map("users")
}

model Company {
  id        String   @id @default(uuid())
  name      String   @default("ArendaHub")
  email     String?
  phone     String?
  address   String?
  logoUrl   String?
  currency  String   @default("UZS")
  locale    String   @default("uz")
  timezone  String   @default("Asia/Tashkent")
  taxRate   Float    @default(0.04)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("company")
}

model Property {
  id          String         @id @default(uuid())
  title       String
  address     String
  region      String
  district    String
  building    String?
  rentPrice   Float          @default(0)
  rooms       Int            @default(0)
  area        Float          @default(0)
  description String?
  status      PropertyStatus @default(AVAILABLE)
  images      String[]       @default([])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  contracts            Contract[]
  maintenances         Maintenance[]
  roomLockSettings     RoomLockSettings?
  roomAccessGrants     RoomAccessGrant[]
  roomAccessLogEvents  RoomAccessLogEvent[]
  ttlockRemoteCommands TtlockRemoteCommand[]

  @@index([status])
  @@index([region])
  @@index([building])
  @@map("properties")
}

model Tenant {
  id               String    @id @default(uuid())
  clientNumber     String?   @unique
  fullName         String
  phone            String
  passport         String
  login            String?   @unique
  password         String?
  telegram         String?
  telegramChatId   String?   @unique
  email            String?
  address          String?
  rentAmount       Float     @default(0)
  contractDuration Int?
  entryDate        DateTime?
  paymentDueDate   DateTime?
  depositPaid      Boolean   @default(false)
  depositAmount    Float     @default(0)
  leftAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  contracts        Contract[]
  clients          Client[]
  archives         TenantArchive[]
  telegramBotUsers TelegramBotUser[]
  roomAccessGrants RoomAccessGrant[]
  smsLinks         SmsTenantLink[]

  @@map("tenants")
}

model Contract {
  id          String         @id @default(uuid())
  propertyId  String
  tenantId    String
  startDate   DateTime
  endDate     DateTime
  monthlyRent Float          @default(0)
  deposit     Float          @default(0)
  depositPaid Boolean        @default(false)
  status      ContractStatus @default(ACTIVE)
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  property Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments Payment[]
  archives TenantArchive[]
  smsLinks SmsTenantLink[]

  @@index([status])
  @@index([propertyId])
  @@index([tenantId])
  @@map("contracts")
}

/// SMS xabarnoma bo‘limiga biriktirilgan arendator (xona/shartnoma bo‘yicha)
model SmsTenantLink {
  id              String   @id @default(uuid())
  tenantId        String
  /**
   * Shartnoma yo‘q bo‘lsa "none" — unique uchun
   */
  scopeKey        String   @default("none")
  contractId      String?
  propertyId      String?
  propertyLabel   String   @default("")
  smsEnabled      Boolean  @default(true)
  dueSoon         Boolean  @default(true)
  debtReminder    Boolean  @default(true)
  paymentReceived Boolean  @default(false)
  general         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@unique([tenantId, scopeKey])
  @@index([tenantId])
  @@index([contractId])
  @@index([createdAt])
  @@map("sms_tenant_links")
}

model Payment {
  id            String        @id @default(uuid())
  contractId    String
  amount        Float
  paymentDate   DateTime      @default(now())
  /**
   * Qaysi oy uchun to'langan (1–12). Belgilansa shu oyga birikadi.
   */
  periodYear    Int?
  periodMonth   Int?
  paymentMethod PaymentMethod @default(CASH)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([paymentDate])
  @@index([periodYear, periodMonth])
  @@map("payments")
}

model PartnerCompany {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees         Employee[]
  recurringExpenses RecurringExpense[]

  @@index([name])
  @@index([active])
  @@map("companies")
}

model Employee {
  id            String   @id @default(uuid())
  fullName      String
  phone         String?
  position      String?
  monthlySalary Float    @default(0)
  /**
   * Har oy oylik beriladigan kun (1–31)
   */
  salaryPayDay  Int?
  active        Boolean  @default(true)
  notes         String?
  companyId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company  PartnerCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  expenses Expense[]

  @@index([active])
  @@index([fullName])
  @@index([salaryPayDay])
  @@index([companyId])
  @@map("employees")
}

model Expense {
  id                 String              @id @default(uuid())
  title              String
  amount             Float
  category           ExpenseCategory     @default(OTHER)
  date               DateTime            @default(now())
  notes              String?
  receiptUrl         String?
  employeeId         String?
  /**
   * Oylik xarajat turi: suv, elektr, ofis, boshqa
   */
  monthlyType        MonthlyExpenseType?
  /**
   * monthlyType=CUSTOM bo‘lganda foydalanuvchi yozgan nom
   */
  monthlyTypeCustom  String?
  /**
   * MANUAL | RECURRING_EXPENSE
   */
  source             ExpenseSource       @default(MANUAL)
  recurringExpenseId String?
  /**
   * Masalan 2026-08 — doimiy xarajat occurrence oy kaliti
   */
  paymentPeriodKey   String?
  plannedDueDate     DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  employee         Employee?         @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  recurringExpense RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)

  @@unique([recurringExpenseId, paymentPeriodKey])
  @@index([category])
  @@index([date])
  @@index([employeeId])
  @@index([monthlyType])
  @@index([source])
  @@index([recurringExpenseId])
  @@index([paymentPeriodKey])
  @@map("expenses")
}

model RecurringExpense {
  id                String              @id @default(uuid())
  name              String
  amount            Float
  category          ExpenseCategory     @default(OTHER)
  monthlyType       MonthlyExpenseType?
  monthlyTypeCustom String?
  notes             String?
  firstPaymentDate  DateTime
  interval          RecurrenceInterval  @default(MONTHLY)
  active            Boolean             @default(true)
  companyId         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  company  PartnerCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  expenses Expense[]

  @@index([active])
  @@index([firstPaymentDate])
  @@index([interval])
  @@index([companyId])
  @@index([name])
  @@map("recurring_expenses")
}

model Maintenance {
  id          String            @id @default(uuid())
  propertyId  String
  title       String
  description String?
  cost        Float             @default(0)
  status      MaintenanceStatus @default(PENDING)
  images      String[]          @default([])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([propertyId])
  @@map("maintenance")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String?
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  meta      Json?
  createdAt DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@map("audit_logs")
}

model Client {
  id            String       @id @default(uuid())
  fullName      String
  phone         String
  status        ClientStatus @default(NEW)
  tenantId      String?
  depositPaid   Boolean      @default(false)
  depositAmount Float        @default(0)
  loginCount    Int          @default(1)
  firstLoginAt  DateTime     @default(now())
  lastLoginAt   DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([phone])
  @@index([status])
  @@index([tenantId])
  @@map("clients")
}

// Klient chiqgandan keyin saqlanadigan to'liq tarix (to'lovlar o'chmaydi)
model TenantArchive {
  id               String    @id @default(uuid())
  clientNumber     String
  tenantId         String?
  contractId       String?
  fullName         String
  phone            String
  passport         String?
  propertyId       String?
  propertyName     String
  entryDate        DateTime?
  leaveDate        DateTime  @default(now())
  contractStart    DateTime
  contractEnd      DateTime
  monthlyRent      Float     @default(0)
  deposit          Float     @default(0)
  depositPaid      Boolean   @default(false)
  contractDuration Int?
  totalPaid        Float     @default(0)
  paymentCount     Int       @default(0)
  notes            String?
  createdAt        DateTime  @default(now())

  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  contract Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@index([clientNumber])
  @@index([tenantId])
  @@index([leaveDate])
  @@index([propertyName])
  @@map("tenant_archives")
}

/**
 * Telefon qilgan / qiziqqan kontaktlar
 */
model ContactLead {
  id        String          @id @default(uuid())
  fullName  String
  phone     String
  interest  ContactInterest @default(CALLED)
  notes     String?
  source    String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([phone])
  @@index([interest])
  @@index([createdAt])
  @@map("contact_leads")
}

model TelegramSession {
  chatId        String    @id
  mode          String    @default("menu")
  pendingEmail  String?
  ownerUserId   String?
  pendingUserId String?
  pendingOtp    String?
  otpExpiresAt  DateTime?
  updatedAt     DateTime  @updatedAt

  @@map("telegram_sessions")
}

model TelegramAdminDevice {
  id        String   @id @default(uuid())
  userId    String
  chatId    String   @unique
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("telegram_admin_devices")
}

/// Botda /start bosgan foydalanuvchilar
model TelegramBotUser {
  id              String    @id @default(uuid())
  chatId          String    @unique
  telegramUserId  String?
  firstName       String?
  lastName        String?
  username        String?
  phone           String?
  selectedRole    String?
  tenantId        String?
  startCount      Int       @default(1)
  firstStartAt    DateTime  @default(now())
  lastStartAt     DateTime  @default(now())
  phoneVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([phone])
  @@index([tenantId])
  @@index([lastStartAt])
  @@map("telegram_bot_users")
}

// ===================== MULTI-PLATFORM LISTING POSTING =====================

enum RentalListingStatus {
  ACTIVE
  DRAFT
  RENTED
  ARCHIVED
}

enum PostingPlatform {
  ARENDA_INTERNAL
  TELEGRAM
  INSTAGRAM
  OLX
  JOYMEE
  EGASI
  BESTE
}

enum PostingJobStatus {
  PENDING
  POSTED
  FAILED
  MANUAL_REQUIRED
}

model RentalListing {
  id            String              @id @default(uuid())
  title         String
  region        String?
  district      String
  propertyType  String
  rooms         Int                 @default(1)
  area          Float               @default(0)
  price         Float
  description   String?
  status        RentalListingStatus @default(ACTIVE)
  landlordEmail String
  landlordName  String?
  legacyLocalId String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  images       RentalListingImage[]
  jobs         PostingJob[]
  telegramJobs TelegramPostingJob[]

  @@index([landlordEmail])
  @@index([status])
  @@map("rental_listings")
}

model RentalListingImage {
  id        String   @id @default(uuid())
  listingId String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  listing RentalListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("rental_listing_images")
}

model PostingChannel {
  id        String          @id @default(uuid())
  platform  PostingPlatform @unique
  enabled   Boolean         @default(false)
  settings  Json            @default("{}")
  secrets   Json            @default("{}")
  updatedAt DateTime        @updatedAt

  @@map("posting_channels")
}

model PostingJob {
  id             String           @id @default(uuid())
  listingId      String
  platform       PostingPlatform
  status         PostingJobStatus @default(PENDING)
  generatedText  String?
  manualPackage  Json?
  externalPostId String?
  postUrl        String?
  channelName    String?
  errorMessage   String?
  retryCount     Int              @default(0)
  postedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  listing RentalListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  logs    PostingLog[]

  @@unique([listingId, platform])
  @@index([status])
  @@map("posting_jobs")
}

model PostingLog {
  id        String   @id @default(uuid())
  jobId     String
  level     String   @default("info")
  message   String
  meta      Json?
  createdAt DateTime @default(now())

  job PostingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("posting_logs")
}

// ===================== TELEGRAM MULTI-CHANNEL DISTRIBUTION =====================

enum TelegramPostingStatus {
  PENDING
  SENDING
  POSTED
  FAILED
}

model TelegramChannel {
  id                  String    @id @default(uuid())
  name                String
  username            String?
  chatId              String
  enabled             Boolean   @default(true)
  regionFilters       String[]  @default([])
  propertyTypeFilters String[]  @default([])
  priority            Int       @default(0)
  isBotAdmin          Boolean?
  lastAdminCheckAt    DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  jobs TelegramPostingJob[]

  @@index([enabled])
  @@map("telegram_channels")
}

model TelegramPostingJob {
  id             String                @id @default(uuid())
  listingId      String
  channelId      String
  status         TelegramPostingStatus @default(PENDING)
  caption        String?
  scheduledAt    DateTime?
  postedAt       DateTime?
  externalPostId String?
  postUrl        String?
  errorMessage   String?
  retryCount     Int                   @default(0)
  maxRetries     Int                   @default(3)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  listing RentalListing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  channel TelegramChannel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  logs    TelegramPostingLog[]

  @@unique([listingId, channelId])
  @@index([status])
  @@index([scheduledAt])
  @@index([listingId])
  @@map("telegram_posting_jobs")
}

model TelegramPostingLog {
  id        String   @id @default(uuid())
  jobId     String
  level     String   @default("info")
  message   String
  meta      Json?
  createdAt DateTime @default(now())

  job TelegramPostingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("telegram_posting_logs")
}

// ===================== LWN AQILLI QULF (ichki sozlamalar) =====================

model RoomLockSettings {
  id                        String    @id @default(uuid())
  propertyId                String    @unique
  providerName              String?
  lockName                  String?
  deviceId                  String?
  notes                     String?
  /**
   * Ixtiyoriy TTLock cache bog‘lanishi — bitta qulf = ko‘pi bilan bitta xona
   */
  ttlockCachedLockId        String?
  /**
   * TTLock kirish tarixi oxirgi muvaffaqiyatli sync (UTC)
   */
  lastAccessHistorySyncedAt DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  property         Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ttlockCachedLock TtlockCachedLock? @relation(fields: [ttlockCachedLockId], references: [id], onDelete: Restrict)

  @@unique([ttlockCachedLockId])
  @@map("room_lock_settings")
}

model RoomAccessGrant {
  id             String                   @id @default(uuid())
  propertyId     String
  tenantId       String
  permissionType RoomAccessPermissionType @default(PIN)
  validFrom      DateTime?
  validTo        DateTime?
  status         RoomAccessGrantStatus    @default(PLANNED)
  notes          String?
  /**
   * Bekor qilingan vaqt (UTC) — CANCELLED holatida
   */
  revokedAt      DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  property         Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant           Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ttlockCredential TtlockAccessCredential?

  @@index([propertyId])
  @@index([tenantId])
  @@index([status])
  @@map("room_access_grants")
}

model RoomAccessLogEvent {
  id                 String   @id @default(uuid())
  propertyId         String
  occurredAt         DateTime
  personLabel        String?
  eventType          String
  method             String?
  direction          String   @default("unknown")
  result             String
  source             String
  /**
   * TTLock tashqi record ID (String) — dedupe
   */
  externalRecordId   String?
  /**
   * externalRecordId yo‘q bo‘lsa deterministic fingerprint
   */
  recordFingerprint  String?
  ttlockCachedLockId String?
  createdAt          DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, externalRecordId])
  @@unique([propertyId, recordFingerprint])
  @@unique([ttlockCachedLockId, externalRecordId])
  @@unique([ttlockCachedLockId, recordFingerprint])
  @@index([propertyId, occurredAt])
  @@map("room_access_log_events")
}

// ===================== TTLock / Sciener =====================
// Organization modeli yo‘q — connection autentifikatsiyalangan admin/owner (User) ga bog‘lanadi.

model TtlockConnection {
  id                    String                 @id @default(uuid())
  ownerUserId           String
  provider              String                 @default("TTLOCK")
  status                TtlockConnectionStatus @default(DISCONNECTED)
  /**
   * Sciener uid — number aniqligi uchun String
   */
  ttlockUid             String?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  lastConnectedAt       DateTime?
  lastSyncedAt          DateTime?
  lastErrorCode         String?
  lastErrorMessage      String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  owner                   User                     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  locks                   TtlockCachedLock[]
  gateways                TtlockGateway[]
  credentials             TtlockAccessCredential[]
  remoteCommands          TtlockRemoteCommand[]
  callbackInbox           TtlockCallbackInbox[]
  lastCallbackReceivedAt  DateTime?
  lastCallbackProcessedAt DateTime?

  @@unique([ownerUserId, provider])
  @@index([status])
  @@map("ttlock_connections")
}

model TtlockGateway {
  id                String                   @id @default(uuid())
  connectionId      String
  /**
   * Sciener gatewayId — String
   */
  externalGatewayId String
  name              String?
  mac               String?
  onlineStatus      TtlockDeviceOnlineStatus @default(UNKNOWN)
  lastHeartbeatAt   DateTime?
  lastSyncedAt      DateTime?
  lastEventAt       DateTime?
  isActive          Boolean                  @default(true)
  removedAt         DateTime?
  /**
   * Maxfiy bo‘lmagan metadata
   */
  capabilities      Json?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  connection TtlockConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  locks      TtlockCachedLock[]

  @@unique([connectionId, externalGatewayId])
  @@index([connectionId])
  @@index([isActive])
  @@map("ttlock_gateways")
}

model TtlockCachedLock {
  id              String                   @id @default(uuid())
  connectionId    String
  /**
   * Tashqi lockId — String (JS number aniqligi)
   */
  externalLockId  String
  name            String
  mac             String?
  model           String?
  firmwareVersion String?
  battery         Int?
  hasGateway      Boolean                  @default(false)
  remoteUnlock    Boolean?
  passcodeCapable Boolean?
  eKeyCapable     Boolean?
  /**
   * Legacy Boolean (1-bosqich migration). CANONICAL emas.
   * Yangi kod faqat onlineStatus o‘qiydi/yozadi; farq bo‘lsa onlineStatus ustun.
   * 1-bosqich migration o‘zgarmaganligi uchun ustun saqlanadi (DROP yo‘q).
   */
  online          Boolean?
  /**
   * Canonical online holat: UNKNOWN | ONLINE | OFFLINE
   */
  onlineStatus    TtlockDeviceOnlineStatus @default(UNKNOWN)
  lastOnlineAt    DateTime?
  gatewayId       String?
  /**
   * Maxfiy bo‘lmagan capability / meta
   */
  capabilities    Json?
  rawSafe         Json?
  lastSyncedAt    DateTime?
  lastEventAt     DateTime?
  isActive        Boolean                  @default(true)
  removedAt       DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  connection        TtlockConnection         @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  gateway           TtlockGateway?           @relation(fields: [gatewayId], references: [id], onDelete: SetNull)
  roomLockSettings  RoomLockSettings[]
  accessCredentials TtlockAccessCredential[]
  remoteCommands    TtlockRemoteCommand[]

  @@unique([connectionId, externalLockId])
  @@index([connectionId])
  @@index([gatewayId])
  @@index([isActive])
  @@map("ttlock_cached_locks")
}

/**
 * RoomAccessGrant ga bog‘langan TTLock provider-detail (1:1)
 */
model TtlockAccessCredential {
  id                  String                     @id @default(uuid())
  roomAccessGrantId   String                     @unique
  connectionId        String
  ttlockCachedLockId  String
  accessType          TtlockAccessCredentialType
  syncStatus          TtlockAccessSyncStatus     @default(PLANNED)
  /**
   * Sciener qaytargan tashqi access ID
   */
  externalAccessId    String?
  /**
   * AES-256-GCM — parol/eKey hech qanday qismi plaintext saqlanmaydi
   */
  credentialEncrypted String?
  sentAt              DateTime?
  lastSyncedAt        DateTime?
  revokedAt           DateTime?
  lastErrorCode       String?
  lastErrorMessage    String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  grant      RoomAccessGrant  @relation(fields: [roomAccessGrantId], references: [id], onDelete: Cascade)
  connection TtlockConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  lock       TtlockCachedLock @relation(fields: [ttlockCachedLockId], references: [id], onDelete: Restrict)

  @@index([connectionId])
  @@index([ttlockCachedLockId])
  @@index([syncStatus])
  @@map("ttlock_access_credentials")
}

/**
 * Masofadan unlock/lock audit (maxfiy ma’lumot saqlanmaydi)
 */
model TtlockRemoteCommand {
  id                 String                    @id @default(uuid())
  propertyId         String
  ttlockCachedLockId String
  connectionId       String
  initiatedByUserId  String
  commandType        TtlockRemoteCommandType
  status             TtlockRemoteCommandStatus @default(PENDING)
  idempotencyKey     String                    @unique
  providerRequestId  String?
  lastErrorCode      String?
  lastErrorMessage   String?
  startedAt          DateTime                  @default(now())
  finishedAt         DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  property    Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  lock        TtlockCachedLock @relation(fields: [ttlockCachedLockId], references: [id], onDelete: Restrict)
  connection  TtlockConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  initiatedBy User             @relation(fields: [initiatedByUserId], references: [id], onDelete: Cascade)

  @@index([ttlockCachedLockId, status])
  @@index([propertyId])
  @@map("ttlock_remote_commands")
}

// ===================== TTLock 9-bosqich: callback inbox =====================

enum TtlockCallbackInboxStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  DUPLICATE
  UNRESOLVED
  FAILED
}

model TtlockCallbackInbox {
  id                   String                    @id @default(uuid())
  connectionId         String?
  providerDeliveryId   String?
  eventFingerprint     String
  notifyType           Int?
  semanticEventType    String?
  externalLockId       String?
  externalGatewayId    String?
  providerEventAt      DateTime?
  status               TtlockCallbackInboxStatus @default(RECEIVED)
  attempts             Int                       @default(0)
  nextRetryAt          DateTime?
  receivedAt           DateTime                  @default(now())
  processingStartedAt  DateTime?
  processingLeaseUntil DateTime?
  processingWorkerId   String?
  processedAt          DateTime?
  lastErrorCode        String?
  lastErrorMessage     String?
  /**
   * Raw body SHA-256 — to‘liq payload saqlanmaydi
   */
  payloadHash          String
  sanitizedMetadata    Json?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  connection TtlockConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@unique([eventFingerprint])
  @@index([connectionId])
  @@index([status, nextRetryAt])
  @@index([status, processingLeaseUntil])
  @@map("ttlock_callback_inbox")
}
