# Hermes runtime env (NO production DB / Telegram / TTLock secrets)

# Arenda Agent Gateway
HERMES_ARENDA_API_BASE_URL=https://www.arendaai.uz
HERMES_ARENDA_CLIENT_ID=hermes-arenda-ai
HERMES_ARENDA_CLIENT_SECRET=  # same as AGENT_GATEWAY_CLIENT_SECRET on Arenda AI

HERMES_DAILY_REPORT_TIMEZONE=Asia/Tashkent
HERMES_DAILY_REPORT_HOUR=8
HERMES_DRY_RUN=true
HERMES_MODEL=upstage/solar-pro4:free
HERMES_PROVIDER=nous
HERMES_REASONING=low
HERMES_RUN_TIMEOUT_SECONDS=180
HERMES_EXPECTED_VERSION=0.21.3

# Optional: isolate Hermes home under this project
# HERMES_HOME=./.hermes

# FORBIDDEN on Hermes:
# DATABASE_URL=
# TELEGRAM_BOT_TOKEN=
# TTLOCK_*=
